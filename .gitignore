__pycache__/
.pytest_cache/

# Downloaded inputs: 2.5 GB sci-Plex h5ad, PDB/mmCIF entries, cached ChEMBL responses.
# Regenerated by verify_sciplex.py, docking_validation.py, chembl_targets.py.
data/raw/*

# Derived matrices, regenerable from data/raw.
# *.h5ad  <- subset_single_cell.py, single_cell_qc.py
# *.npz   <- pseudobulk.py
data/*.h5ad
data/*.npz

# Keep the provenance sidecars (shape, seed, checksums, thresholds).
!data/*.json

# Result tables are the evidence for every documented claim, so they are versioned as data
# (2.4 MB of CSV/JSON). Only regenerable binaries and intermediates are excluded:
#   *.npz    ESM embeddings, chemCPA prediction arrays  <- esm_embeddings.py, chemcpa_predict.py
#   *.pdbqt  431 docking poses                          <- docking_validation.py, dock_candidates.py
#   *.pdb    prepared receptors                         <- docking.py
#   archive/ outputs superseded by later sessions, kept on disk only
results/**/*.npz
results/**/*.pdbqt
results/**/*.pdb
results/archive/
